{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "VCPKG",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "/home/jasper/Downloads/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "CMAKE_CUDA_SEPARABLE_COMPILATION": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "86",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      },
      "hidden": true
    },
    {
      "name": "gcc-14",
      "displayName": "GCC 14",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CUDA_STANDARD": "23"
      },
      "environment": {
        "NVIDIA_HPC_SDK": "/opt/nvidia/hpc_sdk/Linux_x86_64/25.3",
        "CUDACXX": "$env{NVIDIA_HPC_SDK}/compilers/bin/nvcc"
      },
      "hidden": true
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "hidden": true
    },
    {
      "name": "release",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "hidden": true
    },
    {
      "name": "debug-gcc-14",
      "displayName": "Debug GCC-14",
      "inherits": ["vcpkg", "gcc-14", "debug"],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-g -O0 -Wall -Wextra",
        "CMAKE_CUDA_FLAGS": "-G -O0 -g -Xcompiler=-rdynamic"
      }
    },
    {
      "name": "release-gcc-14",
      "displayName": "Release GCC-14",
      "inherits": ["vcpkg", "gcc-14", "release"],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O3 -DNDEBUG -Wall -Wextra -Werror",
        "CMAKE_CUDA_FLAGS": "-Xptxas -v -O3 --use_fast_math -dopt=on"
      }
    }
  ]
}